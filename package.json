{
  "name": "gyeol-personality",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run validate:content && next build",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsc -p tsconfig.tests.json && node .test-build/scripts/validate.js",
    "test:unit": "tsc -p tsconfig.tests.json && node --test .test-build/tests/scoring.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format:check": "prettier --check src scripts tests"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.6.0"
  }
}
